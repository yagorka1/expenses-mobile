rules_version = '2';

// Only accounts listed in /members/{uid} get access. Firebase Auth with email/password lets anyone
// create an account using the public web config, so "signed in" alone is not enough.
// The bot and the migration script use the Admin SDK and bypass these rules.
service cloud.firestore {
  match /databases/{database}/documents {
    function isMember() {
      return request.auth != null
        && exists(/databases/$(database)/documents/members/$(request.auth.uid));
    }

    function isValidExpense(data) {
      return data.keys().hasAll([
          'amount', 'currency', 'categoryId', 'categoryName', 'subcategoryId',
          'subcategoryName', 'person', 'description', 'date', 'amounts'
        ])
        && data.amount is number && data.amount > 0
        && data.currency is string
        && data.categoryId is string && data.subcategoryId is string
        && data.person is string
        && data.description is string && data.description.size() <= 200
        && data.date is timestamp
        && data.amounts is map;
    }

    match /expenses/{expenseId} {
      allow read, delete: if isMember();
      allow create: if isMember()
        && isValidExpense(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isMember() && isValidExpense(request.resource.data);
    }

    match /categories/{categoryId} {
      allow read, write: if isMember();
    }

    match /subcategories/{subcategoryId} {
      allow read, write: if isMember();
    }

    match /members/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
